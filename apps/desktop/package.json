{
  "name": "@ai-office/desktop",
  "version": "0.1.0",
  "description": "AI Office desktop agent overlay",
  "author": "AI Office",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.aioffice.desktop",
    "productName": "AI Office",
    "files": ["main.cjs", "README.md"],
    "mac": { "target": ["dmg", "zip"] },
    "dmg": { "title": "AI Office" }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.15.3"
  }
}
